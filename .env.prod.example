FRAMEDATA_IMAGE_REPOSITORY=ghcr.io/nmur
FRAMEDATA_IMAGE_TAG=stable

POSTGRES_DB=framedata
POSTGRES_USER=framedata
POSTGRES_PASSWORD=change-me
FRAMEDATA_POSTGRES_DATA=/srv/framedatabot/postgres
FRAMEDATA_EXPORTS_PATH=/srv/framedatabot/exports
FRAMEDATA_SEQ_DATA=/srv/framedatabot/seq

API_PORT=8080
BOT_API_BASE_URL=http://api:8080

SEQ_IMAGE_TAG=latest
SEQ_PORT=5341
SEQ_ADMIN_PASSWORD=change-me
SEQ_SERVER_URL=http://seq
SEQ_API_KEY=
SEQ_MINIMUM_LEVEL=Debug

# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Numeric Discord guild ID where /framedata should be registered.
BOT_GUILD_ID=

INGESTION_SOURCE_BASE_URL=http://ensabahnur.free.fr/BastonNew/index.php
INGESTION_CHARACTER_SCOPE=
FRAMEDATA_BACKUP_PATH=/app/exports/backups/latest
FRAMEDATA_RESTORE_PATH=/app/exports/backups/latest

# Optional scoped one-shot ingestion example:
# docker compose -f docker-compose.prod.yml run --rm ingestion --characters=makoto,chun-li
# Optional backup/restore examples:
# docker compose -f docker-compose.prod.yml run --rm ingestion backup --out /app/exports/backups/latest
# docker compose -f docker-compose.prod.yml run --rm ingestion restore --in /app/exports/backups/latest
