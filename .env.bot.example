COMPOSE_PROJECT_NAME=framedatabot

FRAMEDATA_IMAGE_REPOSITORY=ghcr.io/nmur
FRAMEDATA_IMAGE_TAG=stable

FRAMEDATA_DATASET_HOST_ROOT=/srv/framedatabot/dataset
FRAMEDATA_DATASET_ROOT=/data/framedata
FRAMEDATA_ACTIVE_DATASET_PATH=/data/framedata/active
FRAMEDATA_SEQ_DATA=/srv/framedatabot/seq
FRAMEDATA_DOCKER_NETWORK=framedatabot

API_PORT=8080
BOT_API_BASE_URL=http://api:8080

SEQ_IMAGE_TAG=latest
SEQ_PORT=5341
SEQ_ADMIN_PASSWORD=change-me
SEQ_SERVER_URL=http://seq
SEQ_API_KEY=
SEQ_MINIMUM_LEVEL=Debug

# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Register /framedata globally for every installing server, or set to "guild" for beta/test guild-scoped registration.
DISCORD_COMMAND_REGISTRATION_SCOPE=global

# Required only when DISCORD_COMMAND_REGISTRATION_SCOPE=guild.
# Comma-separated numeric Discord guild IDs where /framedata should be registered.
BOT_GUILD_IDS=
