# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Numeric Discord guild ID where /framedata should be registered.
BOT_GUILD_ID=

# Internal Bot -> API base URL on the compose network.
BOT_API_BASE_URL=http://api:8080

API_BIND_URL=http://0.0.0.0:8080
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=framedata;Username=framedata;Password=framedata
