# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Numeric Discord guild ID where /framedata should be registered.
BOT_GUILD_ID=

# Internal Bot -> API base URL on the compose network.
BOT_API_BASE_URL=http://api:8080

API_BIND_URL=http://0.0.0.0:8080
API_PORT=8080
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=framedata;Username=framedata;Password=framedata

# Source frame-data page used by the one-shot ingestion worker and API-triggered runs.
INGESTION_SOURCE_BASE_URL=http://ensabahnur.free.fr/BastonNew/index.php
INGESTION_CHARACTER_SCOPE=

# Host path for generated per-character JSON exports when using production-style mounts.
FRAMEDATA_EXPORTS_PATH=./data/exports

# Container paths used by the ingestion worker backup/restore modes.
FRAMEDATA_BACKUP_PATH=/app/exports/backups/latest
FRAMEDATA_RESTORE_PATH=/app/exports/backups/latest
