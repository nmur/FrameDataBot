# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Register /framedata globally for every installing server, or set to "guild" for beta/test guild-scoped registration.
DISCORD_COMMAND_REGISTRATION_SCOPE=global

# Required only when DISCORD_COMMAND_REGISTRATION_SCOPE=guild.
# Comma-separated numeric Discord guild IDs where /framedata should be registered.
# BOT_GUILD_IDS=
# Legacy single-server setting is also supported in guild scope.
# BOT_GUILD_ID=

# Internal Bot -> API base URL on the compose network.
BOT_API_BASE_URL=http://api:8080

API_BIND_URL=http://0.0.0.0:8080
API_PORT=8080

# Host path mounted by both runtime and ingestion Compose stacks.
FRAMEDATA_DATASET_HOST_ROOT=./data/framedata
FRAMEDATA_DATASET_ROOT=/data/framedata
FRAMEDATA_ACTIVE_DATASET_PATH=/data/framedata/active
FRAMEDATA_DOCKER_NETWORK=framedatabot

# Local Seq UI/API port and service logging settings.
SEQ_PORT=5341
SEQ_ADMIN_PASSWORD=framedata-dev
SEQ_SERVER_URL=http://seq
SEQ_API_KEY=
SEQ_MINIMUM_LEVEL=Debug

# Source frame-data page used by the one-shot ingestion worker.
INGESTION_SOURCE_BASE_URL=http://ensabahnur.free.fr/BastonNew/index.php
INGESTION_CHARACTER_SCOPE=
INGESTION_MEDIA_PILOT_SCOPE=
INGESTION_MEDIA_DUMMY_IMAGE_PATH=
