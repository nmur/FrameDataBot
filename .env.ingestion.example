COMPOSE_PROJECT_NAME=framedatabot

FRAMEDATA_IMAGE_REPOSITORY=ghcr.io/nmur
FRAMEDATA_IMAGE_TAG=stable

FRAMEDATA_DATASET_HOST_ROOT=/srv/framedatabot/dataset
FRAMEDATA_DATASET_ROOT=/data/framedata
FRAMEDATA_ACTIVE_DATASET_PATH=/data/framedata/active
FRAMEDATA_DOCKER_NETWORK=framedatabot

INGESTION_SOURCE_BASE_URL=http://ensabahnur.free.fr/BastonNew/index.php
INGESTION_CHARACTER_SCOPE=
INGESTION_MEDIA_PILOT_SCOPE=
INGESTION_MEDIA_DUMMY_IMAGE_PATH=

SEQ_SERVER_URL=http://seq
SEQ_API_KEY=
SEQ_MINIMUM_LEVEL=Debug

# Examples:
# docker compose --env-file .env.ingestion -f docker-compose.ingestion.yml run --rm ingestion
# docker compose --env-file .env.ingestion -f docker-compose.ingestion.yml run --rm ingestion --characters=makoto,chun-li
# Example pilot media scope: ken/ken-normals-jab,ken/ken-specials-hadouken,ken/ken-superarts-shippu-jinraikyaku
